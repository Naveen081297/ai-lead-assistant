    {
      "parameters": {
        "jsCode": "// Zoho can answer HTTP 200 and still reject the record (e.g. a wrong field API name),\n// so the per-record status is checked. Throwing sends the item to the error branch.\nconst rec = $json.data?.[0];\nif (rec?.status !== 'success') {\n  throw new Error('Zoho did not update the lead: ' + JSON.stringify(rec ?? $json).slice(0, 500));\n}\nreturn [{ json: { ...$('Build Zoho update').first().json, zoho_message: rec.message } }];\n"
      },
