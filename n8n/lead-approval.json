    {
      "parameters": {
        "resume": "form",
        "incomingAuthentication": "basicAuth",
        "formTitle": "Approve the AI reply",
        "formDescription": "=Lead {{ $('Run agent').first().json.lead_id }}: {{ $('Run agent').first().json.lead.name }}, score {{ $('Run agent').first().json.score.score }} ({{ $('Run agent').first().json.score.band }}). The draft is in the approval email. Approving writes the score, notes and reply to Zoho CRM. An edited reply is written exactly as typed and skips the AI fact checks.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Decision",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Approve"
                  },
                  {
                    "option": "Reject"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Your name",
              "requiredField": true
            },
            {
              "fieldLabel": "Edited reply",
              "fieldType": "textarea",
              "placeholder": "Leave empty to approve the draft as written"
            },
            {
              "fieldLabel": "Comment",
              "fieldType": "textarea"
            }
          ]
        },
        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 3,
        "resumeUnit": "days",
        "options": {}
      },
