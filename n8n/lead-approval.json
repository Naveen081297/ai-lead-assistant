    {
      "parameters": {
        "jsCode": "// Turns the agent result plus the approver's form answers into a Zoho update.\n// If the approver edited the reply, their text is what gets written.\nconst r = $('Run agent').first().json;\nconst form = $('Wait for approval').first().json;\nconst edited = String(form['Edited reply'] ?? '').trim();\nconst reviewer = String(form['Your name'] ?? '').trim();\nconst comment = String(form['Comment'] ?? '').trim();\nconst cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);\n\nconst notes = [\n  `Approved by ${reviewer}${edited ? ' (reply edited)' : ''}. Run ${r.run_id}.`,\n  comment && `Reviewer comment: ${comment}`,\n  `Score ${r.score.score}/100 (${r.score.band}): ` + r.score.breakdown.map((b) => `${b.rule} ${b.points}`).join('; '),\n  r.flags.length && `Flags: ${r.flags.join(', ')}`,\n  r.calculations.length && 'Calculations: ' + r.calculations.map((c) => `${c.purpose}: ${c.input} = ${c.result}`).join('; '),\n  r.unanswered_questions.length && 'For a counsellor: ' + r.unanswered_questions.join(' | '),\n  r.reply.citations.length && 'Sources: ' + r.reply.citations.map((c) => `[${c.n}] ${c.source}`).join(', '),\n].filter(Boolean).join('\\n');\n\nreturn [{ json: {\n  lead_id: r.lead_id,\n  run_id: r.run_id,\n  reviewer,\n  comment,\n  reply_edited: Boolean(edited),\n  zoho_body: {\n    data: [{\n      AI_Score: r.score.score,\n      AI_Band: cap(r.score.band),\n      AI_Reply_Subject: r.reply.subject.slice(0, 255),\n      AI_Approved_Reply: (edited || r.reply.body).slice(0, 32000),\n      AI_Notes: notes.slice(0, 32000),\n      AI_Run_ID: r.run_id,\n    }],\n    // Don't fire Zoho workflow rules from this update. If the \"new lead\" rule were\n    // ever changed to \"create or edit\", this update would otherwise re-trigger the\n    // whole flow in a loop.\n    trigger: [],\n  },\n} }];\n"
      },
