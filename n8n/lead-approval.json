    {
      "parameters": {
        "jsCode": "// Builds the approval email. Everything from the lead is untrusted, so it is\n// HTML-escaped: a message containing <a href=...>Click to approve</a> shows up\n// as text in the approver's inbox instead of as a working link.\nconst r = $('Run agent').first().json;\nconst cfg = $('Config').first().json;\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) =>\n  ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst list = (xs) => xs.length ? '<ul>' + xs.map((x) => `<li>${esc(x)}</li>`).join('') + '</ul>' : '<p>None</p>';\nconst oneLine = (s) => String(s ?? '').replace(/[\\r\\n]+/g, ' ').slice(0, 80);\n\nconst formUrl = $execution.resumeFormUrl;\nconst score = r.score.breakdown.map((b) => `${b.rule}: ${b.points}`);\nconst calcs = r.calculations.map((c) => `${c.purpose}: ${c.input} = ${c.result}`);\nconst cites = r.reply.citations.map((c) => `[${c.n}] ${c.title} (${c.source})`);\n\nconst html = `\n<h2>Reply to approve: ${esc(r.lead.name)} (lead ${esc(r.lead_id)})</h2>\n<p><b>Score ${r.score.score}/100, ${esc(r.score.band)}</b>${r.needs_attention ? ' &nbsp;<b style=\"color:#b45309\">Needs a closer look</b>' : ''}</p>\n<p><b>Flags:</b> ${r.flags.length ? esc(r.flags.join(', ')) : 'none'}</p>\n<h3>What the lead wrote</h3>\n<blockquote style=\"white-space:pre-wrap;border-left:3px solid #ccc;padding-left:8px\">${esc(r.lead.message)}</blockquote>\n<h3>Draft reply</h3>\n<p><b>Subject:</b> ${esc(r.reply.subject)}</p>\n<pre style=\"white-space:pre-wrap;font-family:inherit;background:#f6f6f6;padding:8px\">${esc(r.reply.body)}</pre>\n<h3>Sources cited</h3>${list(cites)}\n<h3>Calculations (check these)</h3>${list(calcs)}\n<h3>Questions the documents don't answer</h3>${list(r.unanswered_questions)}\n<h3>Score breakdown</h3>${list(score)}\n<p style=\"font-size:18px\"><a href=\"${esc(formUrl)}\">Open the approval form</a></p>\n<p style=\"color:#666\">Nothing is written to Zoho CRM until you approve. Run ${esc(r.run_id)}.</p>`;\n\nreturn [{ json: {\n  to: cfg.approver_email,\n  subject: `Approve reply: ${oneLine(r.lead.name)} (${r.score.score}, ${r.score.band})`,\n  html,\n} }];\n"
      },
      "id": "8b4d956f-e034-4a56-8759-385a17e5fc0e",
      "name": "Prepare approval email",
      "type": "n8n-nodes-base.code",
