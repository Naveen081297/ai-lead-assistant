# Copy to .env and fill in, or set these as environment variables instead.

# Answers and eval judge when CHAT_MODEL is a Claude model (the default).
LEAD_ASSISTANT_CLAUDE_KEY=

# Only needed for a Gemini chat or embedding model. GOOGLE_API_KEY also works.
# GEMINI_API_KEY=

# Optional overrides (defaults shown)
# CHAT_MODEL=claude-haiku-5-5                  # or e.g. gemini-3.5-flash
# CLAUDE_EFFORT=low                            # Haiku 5.5 always thinks; effort sets how much
# CLAUDE_MAX_TOKENS=16000                      # thinking tokens count against this
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5       # local; changing it requires re-running ingest
# EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
# DOCS_DIR=data/docs
# CHROMA_DIR=chroma_db
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=4
# LLM_TIMEOUT_S=45
# LLM_MAX_RETRIES=2
# Gemini free tier allows 5 generate requests/min per model. Set 4 there; 0 = no throttle.
# LLM_REQUESTS_PER_MINUTE=0

# ---------- Week 2: agent ----------
# AGENT_MAX_STEPS=8                           # agent <-> tools rounds before finalize takes over
# AUDIT_LOG_PATH=logs/audit.jsonl
# LEAD_SOURCE=sample                          # or zoho (Week 3)
# ZOHO_DC=com                                 # in for India, eu, com.au ...
# ZOHO_API_VERSION=v8
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=

# ---------- Week 3: n8n ----------
# Shared secret n8n sends as X-API-Key. Required once the API is reachable from
# outside your machine. Make one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# LEAD_ASSISTANT_API_KEY=
# With LEAD_SOURCE=zoho, ZOHO_REFRESH_TOKEN is the READ token
# (scope ZohoCRM.modules.leads.READ,ZohoCRM.settings.fields.READ). The write token lives only in n8n.
